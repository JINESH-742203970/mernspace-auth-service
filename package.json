{
  "name": "src",
  "version": "1.0.0",
  "description": "The user management service",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"node --loader ts-node/esm\" src/server.ts",
    "format:fix": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:check": "eslint . ",
    "lint:fix": "eslint . --fix",
     "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch --runInBand",
    "start": "node server.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/winston": "^2.4.4",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "prettier": "3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.ts": [
      "npm run format:fix",
      "npm run lint:fix"
    ]
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "http-errors": "^2.0.1",
    "winston": "^3.19.0"
  }
}
